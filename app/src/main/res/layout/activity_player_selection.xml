<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="20dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏏 Select Players"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="30dp"/>

    <!-- Striker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Striker (On Strike)"
        android:textSize="14sp"
        android:textColor="#B3B3B3"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etStriker"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Enter striker name"
        android:textColor="#FFFFFF"
        android:textColorHint="#808080"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="20dp"/>

    <!-- Non-Striker -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Non-Striker"
        android:textSize="14sp"
        android:textColor="#B3B3B3"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etNonStriker"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Enter non-striker name"
        android:textColor="#FFFFFF"
        android:textColorHint="#808080"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="20dp"/>

    <!-- Bowler -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bowler"
        android:textSize="14sp"
        android:textColor="#B3B3B3"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etBowler"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Enter bowler name"
        android:textColor="#FFFFFF"
        android:textColorHint="#808080"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginBottom="30dp"/>

    <!-- Start Match Button -->
    <Button
        android:id="@+id/btnStartMatch"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="▶ START MATCH"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF"/>

</LinearLayout>