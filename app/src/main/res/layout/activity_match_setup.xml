<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0A"
    android:padding="24dp">

    <!-- Status Bar Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="25dp"
        android:background="#0A0A0A"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏏 MATCH SETUP"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.1"
        android:layout_marginBottom="32dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A1A1A"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Team A Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM A NAME"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etTeamA"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. Pakistan"
                android:textColor="#FFFFFF"
                android:textColorHint="#4DFFFFFF"
                android:backgroundTint="#4CAF50"
                android:paddingHorizontal="12dp"
                android:inputType="textCapWords"
                android:layout_marginBottom="20dp"/>

            <!-- Team B Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEAM B NAME"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etTeamB"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. India"
                android:textColor="#FFFFFF"
                android:textColorHint="#4DFFFFFF"
                android:backgroundTint="#2196F3"
                android:paddingHorizontal="12dp"
                android:inputType="textCapWords"
                android:layout_marginBottom="20dp"/>

            <!-- Overs Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MATCH OVERS"
                android:textSize="12sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etOvers"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. 20"
                android:textColor="#FFFFFF"
                android:textColorHint="#4DFFFFFF"
                android:backgroundTint="#FF9800"
                android:paddingHorizontal="12dp"
                android:inputType="number"
                android:maxLength="2"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnStartMatch"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="CONTINUE TO PLAYERS ▶"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"/>

</LinearLayout>