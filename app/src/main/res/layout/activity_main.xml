<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/theme_background"
    android:padding="24dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/llThemeToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackground"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvThemeName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DARK"
                android:textColor="@color/theme_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/ivThemeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_moon"
                app:tint="@color/theme_icon_tint"/>
        </LinearLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="40dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="App Logo"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORIFY"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:letterSpacing="0.1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Professional Cricket Scoring"
            android:textSize="14sp"
            android:textColor="@color/theme_text_secondary"/>
    </LinearLayout>

    <!-- Main Large Action Button -->
    <Button
        android:id="@+id/btnStartMatch"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:text="▶ START NEW MATCH"
        android:textSize="22sp"
        android:textStyle="bold"
        android:backgroundTint="#1B5E20"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="32dp"
        app:cornerRadius="16dp"
        android:elevation="8dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Lower Buttons -->
    <Button
        android:id="@+id/btnTeams"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="👥 MANAGE TEAMS"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#FF9800"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnHistory"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📋 MATCH HISTORY"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#607D8B"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"/>

</LinearLayout>